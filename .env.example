# Python GBDT inference service (see ml/README.md)
SENTINEL_ML_URL=http://127.0.0.1:8000
# Set to 1 so the browser uses /api/score instead of demo mocks
NEXT_PUBLIC_SENTINEL_USE_ML=1

# Midnight oracle. true keeps the existing demo inspector without a wallet.
NEXT_PUBLIC_USE_MOCK_ORACLE=true
NEXT_PUBLIC_MIDNIGHT_NETWORK=preprod
# Public contract address only — never put seeds here.
NEXT_PUBLIC_MIDNIGHT_CONTRACT_ADDRESS=

# Server-only Midnight config (used by /api/midnight/*). Never NEXT_PUBLIC_*.
MIDNIGHT_NETWORK=preprod
MIDNIGHT_CONTRACT_ADDRESS=
MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
# MIDNIGHT_PREPROD_SEED=
